"""End-to-end synthetic test of the evidence-based IMU alignment workflow."""

import json
import math
from types import SimpleNamespace

import numpy as np

import evf.imu.alignment_workflow as workflow_module
from evf.imu.alignment_workflow import ImuAlignmentWorkflow


def _rotation(axis, degrees):
    axis = np.asarray(axis, dtype=float)
    axis /= np.linalg.norm(axis)
    x, y, z = axis
    angle = math.radians(degrees)
    c, s = math.cos(angle), math.sin(angle)
    t = 1.0 - c
    return np.array([
        [t*x*x+c, t*x*y-s*z, t*x*z+s*y],
        [t*x*y+s*z, t*y*y+c, t*y*z-s*x],
        [t*x*z-s*y, t*y*z+s*x, t*z*z+c],
    ])


def _quaternion(matrix):
    """Convert a rotation matrix to scalar-first (w, x, y, z)."""
    m = np.asarray(matrix, dtype=float)
    tr = float(np.trace(m))
    if tr > 0:
        s = math.sqrt(tr + 1.0) * 2.0
        q = (
            0.25*s,
            (m[2, 1]-m[1, 2])/s,
            (m[0, 2]-m[2, 0])/s,
            (m[1, 0]-m[0, 1])/s,
        )
    else:
        i = int(np.argmax(np.diag(m)))
        if i == 0:
            s = math.sqrt(1+m[0, 0]-m[1, 1]-m[2, 2])*2
            q = (
                (m[2, 1]-m[1, 2])/s, 0.25*s,
                (m[0, 1]+m[1, 0])/s, (m[0, 2]+m[2, 0])/s,
            )
        elif i == 1:
            s = math.sqrt(1+m[1, 1]-m[0, 0]-m[2, 2])*2
            q = (
                (m[0, 2]-m[2, 0])/s, (m[0, 1]+m[1, 0])/s,
                0.25*s, (m[1, 2]+m[2, 1])/s,
            )
        else:
            s = math.sqrt(1+m[2, 2]-m[0, 0]-m[1, 1])*2
            q = (
                (m[1, 0]-m[0, 1])/s, (m[0, 2]+m[2, 0])/s,
                (m[1, 2]+m[2, 1])/s, 0.25*s,
            )
    q = np.asarray(q, dtype=float)
    return tuple(q / np.linalg.norm(q))


class _FakeHistory:
    def __init__(self):
        self.records = []

    def latest(self):
        return self.records[-1] if self.records else None

    def samples_between(self, start, end):
        # The test controls the synthetic host-time capture window.
        return list(self.records)


class _FakeService:
    def __init__(self, config_dir):
        self.config_dir = config_dir
        self.stream = SimpleNamespace(history=_FakeHistory())
        self.orientations = {}

    def orientation_at_host_time(self, timestamp):
        return self.orientations.get(timestamp)


def _make_sweep_records(sensor_axis, direction):
    """160 samples, stationary edges, and ~12.8 degrees of motion."""
    records = []
    for i in range(160):
        if 16 <= i < 144:
            gyro = np.asarray(sensor_axis) * direction * 10.0
        else:
            gyro = np.zeros(3)

        records.append(SimpleNamespace(
            device_time_us=i * 10_000,
            sample=SimpleNamespace(
                gyro_dps=tuple(float(v) for v in gyro)
            ),
        ))
    return records


def test_full_synthetic_alignment_workflow_minimum_evidence(
    tmp_path, monkeypatch
):
    service = _FakeService(tmp_path)
    calibration = {
        "gyro_bias_dps": [0.0, 0.0, 0.0],
        "sample_count": 300,
    }
    (tmp_path / "imu_calibration.json").write_text(
        json.dumps(calibration), encoding="utf-8"
    )

    workflow = ImuAlignmentWorkflow(service)

    # Known transforms to recover.
    expected_sensor = _rotation((0.3, -0.8, 0.5), 17.0)
    expected_camera = _rotation((0.4, 0.2, 0.9), 23.0)

    # Make each synthetic sweep last 1.5 seconds without waiting in real time.
    clock_value = [100.0]

    def synthetic_monotonic():
        result = clock_value[0]
        clock_value[0] += 1.5
        return result

    monkeypatch.setattr(
        workflow_module.time, "monotonic", synthetic_monotonic
    )

    # Minimal required four sweeps: +/− altitude and +/− azimuth.
    sweep_specs = [
        ("altitude", 1, np.array([0.0, 1.0, 0.0])),
        ("altitude", -1, np.array([0.0, 1.0, 0.0])),
        ("azimuth", 1, np.array([0.0, 0.0, 1.0])),
        ("azimuth", -1, np.array([0.0, 0.0, 1.0])),
    ]

    for axis, direction, telescope_axis in sweep_specs:
        sensor_axis = expected_sensor.T @ telescope_axis
        service.stream.history.records = _make_sweep_records(
            sensor_axis, direction
        )

        workflow.start_sensor_sweep(axis, direction)
        status = workflow.finish_sensor_sweep()

        assert status["sensor_sweep_count"] >= 1
        assert status["active_sweep"] is None

    sensor_fit = workflow.fit_sensor_alignment()
    np.testing.assert_allclose(
        np.asarray(sensor_fit["matrix"]),
        expected_sensor,
        atol=1e-5,
    )
    assert sensor_fit["rms_deg"] < 1e-4

    # Four distinct synthetic plate solves. Camera->sky matrices are
    # generated by the production conversion; matching IMU orientations
    # are chosen so camera_from_telescope is exactly expected_camera.
    pointings = [
        (10.0, 0.0, 0.0),
        (35.0, 20.0, 10.0),
        (80.0, -15.0, 25.0),
        (140.0, 30.0, -20.0),
    ]

    for frame_id, (ra, dec, roll) in enumerate(pointings, start=1):
        camera_to_sky = workflow_module.orientation_from_radec_roll(
            ra, dec, roll
        )
        telescope_to_sky = camera_to_sky @ expected_camera

        frame_timestamp = float(frame_id)
        service.orientations[frame_timestamp] = (
            frame_id * 1_000_000,
            _quaternion(telescope_to_sky),
        )

        pointing = SimpleNamespace(
            ra_j2000=ra,
            dec_j2000=dec,
            roll=roll,
        )
        workflow.capture_camera_pair(
            pointing,
            frame_timestamp,
            frame_id,
        )

    assert workflow.status()["camera_pair_count"] == 4

    camera_fit = workflow.fit_camera_alignment()
    np.testing.assert_allclose(
        np.asarray(camera_fit["matrix"]),
        expected_camera,
        atol=1e-5,
    )
    assert camera_fit["rms_deg"] < 1e-4

    status = workflow.status()
    assert status["ready_to_finalize"] is True

    measured = workflow.measured_result()
    np.testing.assert_allclose(
        np.asarray(measured["sensor_to_telescope"]),
        expected_sensor,
        atol=1e-5,
    )
    np.testing.assert_allclose(
        np.asarray(measured["camera_from_telescope"]),
        expected_camera,
        atol=1e-5,
    )
    assert measured["calibration_method"] == (
        "physical_sweeps_and_paired_plate_solves_v1"
    )
